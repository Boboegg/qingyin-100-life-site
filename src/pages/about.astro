---
import BaseLayout from '../components/BaseLayout.astro';
import { labIdentity, portalPillars, researchThemes } from '../data/lab';

const lang = 'zh-tw';
const identity = labIdentity[lang];
const title = '關於 LAB';
const intro = '青銀共創百歲人生 LAB 是研究、學程、場域計畫與成果資源的入口，而不只是單一 USR 活動頁。';
---

<BaseLayout lang={lang} title={title} description={intro}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About LAB</span>
      <h1>{title}</h1>
      <p class="page-lede">{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>{identity.title}</h2>
        <p>{identity.concept}</p>
      </div>
      <p class="lead-copy">{identity.summary}</p>
      <dl class="about-meta">
        <div>
          <dt>英文工作名</dt>
          <dd>{identity.englishName}</dd>
        </div>
        <div>
          <dt>核心定位</dt>
          <dd>LAB Portal：研究、場域、學程與成果資源的對外門口</dd>
        </div>
        <div>
          <dt>計畫主持人</dt>
          <dd>陳毓璟 教授（國立中正大學成人及繼續教育學系）</dd>
        </div>
        <div>
          <dt>既有旗艦場域</dt>
          <dd>嘉義縣中埔鄉石硦村籐寮仔社區</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>不是單一計畫頁，而是 LAB 門口</h2>
        <p>原本青銀共創百歲人生 USR 內容會保留，但降成 LAB 旗下旗艦計畫之一。</p>
      </div>
      <div class="portal-grid four">
        {portalPillars.map((pillar) => (
          <article class="portal-card">
            <span class="tag-pill">{pillar.tags[0]}</span>
            <h3>{pillar.title[lang]}</h3>
            <p>{pillar.summary[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>研究與行動定位</h2>
        <p>LAB 的每個研究主題都要能回到場域，也要能回收到學程與成果資源。</p>
      </div>
      <div class="tag-row large">
        {researchThemes.map((theme) => <span>{theme.title[lang]}</span>)}
      </div>
    </div>
  </section>
</BaseLayout>
