---
import BaseLayout from '../../components/BaseLayout.astro';
import { fieldProjects, resourceItems } from '../../data/lab';

const lang = 'en';
const title = 'Field Projects';
const intro = 'Field projects include Young Village, Young Stay, Tengliaozai, and intergenerational caring community centers, each with traceable stories and resources.';
---

<BaseLayout lang={lang} title={title} description={intro}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Field Projects</span>
      <h1>{title}</h1>
      <p class="page-lede">{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>Fields are where the lab works</h2>
        <p>Some materials are already substantial; some await lab confirmation. The page marks uncertainty clearly instead of inventing details.</p>
      </div>
      <div class="portal-grid two">
        {fieldProjects.map((project) => (
          <article class="portal-card field">
            {project.eyebrow && <span class="tag-pill">{project.eyebrow[lang]}</span>}
            <h3>{project.title[lang]}</h3>
            <p>{project.summary[lang]}</p>
            {project.detail && <p class="muted-note">{project.detail[lang]}</p>}
            <div class="tag-row">
              {project.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>Field-related resources</h2>
        <p>Resources are tagged by field, so Young Village, Young Stay, and Tengliaozai can each connect back to relevant outputs.</p>
      </div>
      <div class="resource-grid">
        {resourceItems.map((item) => (
          <article class="resource-card compact">
            <div class="resource-meta">
              <span>{item.year}</span>
              <span>{item.type[lang]}</span>
            </div>
            <h3>{item.title[lang]}</h3>
            <p>{item.summary[lang]}</p>
            <div class="tag-row">
              {item.relations.field.map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
