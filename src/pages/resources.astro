---
import BaseLayout from '../components/BaseLayout.astro';
import { resourceItems } from '../data/lab';

const lang = 'zh-tw';
const title = '成果與資源';
const intro = '成果與資源是 LAB 的共用資料庫，用標籤連回研究主題、場域計畫與學分學程。';
---

<BaseLayout lang={lang} title={title} description={intro}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Resource Library</span>
      <h1>{title}</h1>
      <p class="page-lede">{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>標籤如何運作</h2>
        <p>同一筆成果只維護一次，透過標籤同時出現在研究主題、場域計畫與學分學程。</p>
      </div>
      <div class="portal-grid three">
        <article class="portal-card">
          <span class="tag-pill">research</span>
          <h3>研究主題</h3>
          <p>用代間學習、健康促進、AI / 數位健康等主題找成果。</p>
        </article>
        <article class="portal-card">
          <span class="tag-pill">field</span>
          <h3>場域計畫</h3>
          <p>用 Young Village、Young Stay、籐寮仔等場域找成果。</p>
        </article>
        <article class="portal-card">
          <span class="tag-pill">program</span>
          <h3>學分學程</h3>
          <p>用課程地圖、社區實習、暑期駐村與學生作品找成果。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>第一版成果清單</h2>
        <p>這裡先放已知且可公開描述的成果；照片與個資仍需逐項確認授權。</p>
      </div>
      <div class="resource-grid">
        {resourceItems.map((item) => (
          <article class="resource-card">
            <div class="resource-meta">
              <span>{item.year}</span>
              <span>{item.type[lang]}</span>
            </div>
            <h3>{item.title[lang]}</h3>
            <p>{item.summary[lang]}</p>
            <div class="tag-row">
              {item.tags.map((tag) => <span>{tag}</span>)}
            </div>
            <div class="relation-row">
              <strong>研究主題</strong>
              <span>{item.relations.research.join(' / ')}</span>
            </div>
            <div class="relation-row">
              <strong>場域計畫</strong>
              <span>{item.relations.field.join(' / ')}</span>
            </div>
            <div class="relation-row">
              <strong>學分學程</strong>
              <span>{item.relations.program.join(' / ')}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
