---
import BaseLayout from '../../components/BaseLayout.astro';
import { labIdentity, portalPillars, researchThemes } from '../../data/lab';

const lang = 'en';
const identity = labIdentity[lang];
const title = 'About';
const intro = 'The 100-Year Life Co-Creation Lab is a portal for research, field projects, the credit program, and tagged resources.';
---

<BaseLayout lang={lang} title={title} description={intro}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About LAB</span>
      <h1>{title}</h1>
      <p class="page-lede">{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>{identity.title}</h2>
        <p>{identity.concept}</p>
      </div>
      <p class="lead-copy">{identity.summary}</p>
      <dl class="about-meta">
        <div>
          <dt>Chinese name</dt>
          <dd>{identity.englishName}</dd>
        </div>
        <div>
          <dt>Core position</dt>
          <dd>LAB Portal: an entry point for research, fields, the credit program, and resources</dd>
        </div>
        <div>
          <dt>Principal Investigator</dt>
          <dd>Prof. Yu-Ching Chen, Department of Adult and Continuing Education, National Chung Cheng University</dd>
        </div>
        <div>
          <dt>Existing flagship site</dt>
          <dd>Tengliaozai Community, Shihke Village, Zhongpu Township, Chiayi County</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>Not a single project page</h2>
        <p>The existing USR work remains important, but it becomes one flagship effort under the broader lab portal.</p>
      </div>
      <div class="portal-grid four">
        {portalPillars.map((pillar) => (
          <article class="portal-card">
            <span class="tag-pill">{pillar.tags[0]}</span>
            <h3>{pillar.title[lang]}</h3>
            <p>{pillar.summary[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>Research and action position</h2>
        <p>Every research theme should connect back to field projects, the credit program, and the tagged resource library.</p>
      </div>
      <div class="tag-row large">
        {researchThemes.map((theme) => <span>{theme.title[lang]}</span>)}
      </div>
    </div>
  </section>
</BaseLayout>
