---
import BaseLayout from './BaseLayout.astro';
import { home, site, type Locale } from '../data/site';
import { fieldProjects, labStats, portalPillars, programSections, researchThemes, resourceItems } from '../data/lab';

type Props = {
  lang?: Locale;
};

const { lang = 'zh-tw' } = Astro.props;
const copy = home[lang] as {
  eyebrow: string;
  title: string;
  subtitle: string;
  primaryCta: string;
  secondaryCta: string;
  pillarsTitle: string;
  researchTitle: string;
  researchIntro: string;
  fieldTitle: string;
  fieldIntro: string;
  programTitle: string;
  programIntro: string;
  resourcesTitle: string;
  resourcesIntro: string;
  invitationTitle: string;
  invitationText: string;
};

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (value: string) => `${base}${lang === 'en' ? `/en${value === '/' ? '/' : value}` : value}`;
const pillarPath = (id: string) => {
  if (id === 'research') return path('/research/');
  if (id === 'field-projects') return path('/field-projects/');
  if (id === 'program') return path('/program/');
  return path('/resources/');
};
---

<BaseLayout lang={lang} title={lang === 'en' ? 'Home' : undefined} description={site.description[lang]}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1><span class="highlight-line">{copy.title}</span></h1>
        <p class="hero-concept">Intergenerational Learning, Caring Communities, and Healthy Aging</p>
        <p class="hero-lede">{copy.subtitle}</p>
        <div class="hero-actions">
          <a class="button primary" href={path('/research/')}>{copy.primaryCta}</a>
          <a class="button secondary" href={path('/resources/')}>{copy.secondaryCta}</a>
        </div>
      </div>

      <div class="collage" aria-label={lang === 'en' ? 'LAB portal structure collage' : 'LAB Portal 架構拼貼'}>
        <div class="sticky-note">
          {lang === 'en' ? 'Tag once, reuse everywhere' : '成果只維護一次'}
          <small>{lang === 'en' ? 'Research, field projects, program, resources.' : '用標籤串聯研究、場域、學程與成果。'}</small>
        </div>
        <div class="photo-card large">
          <span class="tape"></span>
          <div class="photo-fill">{lang === 'en' ? 'Research x Field' : '研究主題 x 場域計畫'}</div>
        </div>
        <div class="photo-card small">
          <span class="tape"></span>
          <div class="photo-fill">{lang === 'en' ? 'Program x Resources' : '學分學程 x 成果資源'}</div>
        </div>
        <svg class="doodle-arrow" viewBox="0 0 180 80" aria-hidden="true">
          <path d="M12 45 C 42 10, 82 12, 112 38 S 150 62, 168 32" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path>
          <path d="M150 24 L170 31 L156 49" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <div class="section-heading">
        <h2>{copy.pillarsTitle}</h2>
      </div>
      <div class="portal-grid four">
        {portalPillars.map((pillar) => (
          <a class="portal-card linked" href={pillarPath(pillar.id)}>
            <span class="tag-pill">{pillar.tags[0]}</span>
            <h3>{pillar.title[lang]}</h3>
            <p>{pillar.summary[lang]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <div class="section-heading">
        <h2>{copy.researchTitle}</h2>
        <p>{copy.researchIntro}</p>
      </div>
      <div class="portal-grid three">
        {researchThemes.map((theme) => (
          <article class="portal-card">
            <span class="card-kicker">{theme.tags[0]}</span>
            <h3>{theme.title[lang]}</h3>
            <p>{theme.summary[lang]}</p>
          </article>
        ))}
      </div>
      <p class="project-strip-cta">
        <a href={path('/research/')}>{lang === 'en' ? 'View all research themes ->' : '看完整研究主題 ->'}</a>
      </p>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <div class="section-heading">
        <h2>{copy.fieldTitle}</h2>
        <p>{copy.fieldIntro}</p>
      </div>
      <div class="portal-grid two">
        {fieldProjects.map((project) => (
          <article class="portal-card field">
            {project.eyebrow && <span class="tag-pill">{project.eyebrow[lang]}</span>}
            <h3>{project.title[lang]}</h3>
            <p>{project.summary[lang]}</p>
            {project.detail && <p class="muted-note">{project.detail[lang]}</p>}
          </article>
        ))}
      </div>
      <p class="project-strip-cta">
        <a href={path('/field-projects/')}>{lang === 'en' ? 'Explore field projects ->' : '看場域計畫 ->'}</a>
      </p>
    </div>
  </section>

  <section class="section reveal">
    <div class="container scrapbook">
      <div class="section-heading stack">
        <h2>{copy.programTitle}</h2>
        <p>{copy.programIntro}</p>
        <p class="project-strip-cta inline">
          <a href={path('/program/')}>{lang === 'en' ? 'Open the credit program ->' : '看學分學程 ->'}</a>
        </p>
      </div>
      <div class="relation-list">
        {programSections.map((section) => (
          <article>
            <span class="card-kicker">{section.tags[0]}</span>
            <h3>{section.title[lang]}</h3>
            <p>{section.summary[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <div class="section-heading">
        <h2>{copy.resourcesTitle}</h2>
        <p>{copy.resourcesIntro}</p>
      </div>
      <div class="resource-grid">
        {resourceItems.slice(0, 3).map((item) => (
          <article class="resource-card">
            <div class="resource-meta">
              <span>{item.year}</span>
              <span>{item.type[lang]}</span>
            </div>
            <h3>{item.title[lang]}</h3>
            <p>{item.summary[lang]}</p>
            <div class="tag-row">
              {item.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
      <p class="project-strip-cta">
        <a href={path('/resources/')}>{lang === 'en' ? 'Browse tagged resources ->' : '瀏覽標籤化成果資源 ->'}</a>
      </p>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <div class="home-stat-grid">
        {labStats.map((stat) => (
          <article>
            <div class="stat-num">{stat.value}</div>
            <div class="stat-label">{stat.label[lang]}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="container">
      <div class="invite">
        <h2>{copy.invitationTitle}</h2>
        <p>{copy.invitationText}</p>
      </div>
    </div>
  </section>
</BaseLayout>
