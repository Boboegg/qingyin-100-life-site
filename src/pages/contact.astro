---
import BaseLayout from '../components/BaseLayout.astro';

const lang = 'zh-tw';
const title = '聯絡合作';
const intro = '如果你想了解 LAB 研究、場域計畫、青銀共創跨域學分學程或成果資源，歡迎從這裡聯絡。';
---

<BaseLayout lang={lang} title={title} description={intro}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>{title}</h1>
      <p class="page-lede">{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>LAB 聯絡資訊</h2>
        <p>第一時間最適合的聯繫窗口。</p>
      </div>

      <div class="contact-grid">
        <article class="contact-card">
          <h3>主持人</h3>
          <p class="contact-role">陳毓璟　教授</p>
          <p class="contact-affil">國立中正大學<br />成人及繼續教育學系</p>
          <p class="contact-line">Email <a href="mailto:eduycc@ccu.edu.tw">eduycc@ccu.edu.tw</a></p>
        </article>

        <article class="contact-card">
          <h3>計畫聯絡人</h3>
          <p class="contact-role">曾柏儒</p>
          <p class="contact-affil">中正大學成教所博士班</p>
          <p class="contact-line">來信請主旨註明「青銀共創百歲人生 LAB」</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>適合聯絡我們的主題</h2>
        <p>把需求對準 LAB 架構，後續就能更快找到對應資料與合作窗口。</p>
      </div>

      <ul class="invite-list">
        <li>
          <h4>研究合作</h4>
          <p>代間學習、高齡學習、健康促進、社區照顧、AI / 數位健康與地方實踐。</p>
        </li>
        <li>
          <h4>場域合作</h4>
          <p>Young Village、Young Stay、跨世代關懷社區據點與地方組織合作。</p>
        </li>
        <li>
          <h4>學程與課程</h4>
          <p>青銀共創跨域學分學程、社區實習、暑期駐村、學生作品與課程成果。</p>
        </li>
        <li>
          <h4>成果與媒體</h4>
          <p>影片、照片、新聞、教材、研討會、活動紀錄；含人像素材需事前確認授權。</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>所屬單位</h2>
        <p>本 LAB 由中正大學成人及繼續教育學系相關研究與計畫脈絡支持。</p>
      </div>

      <div class="affil-block">
        <p><strong>國立中正大學　成人及繼續教育學系</strong></p>
        <p>系所網站：<a href="https://cyiaace.ccu.edu.tw/" target="_blank" rel="noopener noreferrer">cyiaace.ccu.edu.tw</a></p>
        <p>USR 辦公室：<a href="https://usr.ccu.edu.tw/" target="_blank" rel="noopener noreferrer">usr.ccu.edu.tw</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
