---
import BaseLayout from '../../components/BaseLayout.astro';

const lang = 'en';
const title = 'Contact';
const intro = 'Reach out about lab research, field projects, the credit program, or tagged resources.';
---

<BaseLayout lang={lang} title={title} description={intro}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>{title}</h1>
      <p class="page-lede">{intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>Lab contacts</h2>
        <p>The right place to start.</p>
      </div>

      <div class="contact-grid">
        <article class="contact-card">
          <h3>Principal Investigator</h3>
          <p class="contact-role">Prof. Yu-Ching Chen</p>
          <p class="contact-affil">Department of Adult and Continuing Education<br />National Chung Cheng University</p>
          <p class="contact-line">Email <a href="mailto:eduycc@ccu.edu.tw">eduycc@ccu.edu.tw</a></p>
        </article>

        <article class="contact-card">
          <h3>Project Coordinator</h3>
          <p class="contact-role">Bo-Ru Tseng</p>
          <p class="contact-affil">PhD Candidate, Adult and Continuing Education, NCCU</p>
          <p class="contact-line">Please note “100-Year Life Co-Creation Lab” in the subject line.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>Good reasons to contact us</h2>
        <p>Mapping the request to the lab structure helps us find the right materials and collaborators faster.</p>
      </div>

      <ul class="invite-list">
        <li>
          <h4>Research collaboration</h4>
          <p>Intergenerational learning, older-adult learning, health promotion, community care, AI and digital health, and local practice.</p>
        </li>
        <li>
          <h4>Field collaboration</h4>
          <p>Young Village, Young Stay, intergenerational caring community centers, and local organization partnerships.</p>
        </li>
        <li>
          <h4>Credit program and courses</h4>
          <p>The Qingyin intergenerational credit program, community practicum, summer residency, student work, and course outputs.</p>
        </li>
        <li>
          <h4>Resources and media</h4>
          <p>Videos, photos, news, teaching materials, symposium records, and activity records. Identifiable images require consent checks.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container page-panel">
      <div class="section-heading">
        <h2>Affiliation</h2>
        <p>The lab is supported by research and project contexts around the Department of Adult and Continuing Education, NCCU.</p>
      </div>

      <div class="affil-block">
        <p><strong>Department of Adult and Continuing Education, National Chung Cheng University</strong></p>
        <p>Department site: <a href="https://cyiaace.ccu.edu.tw/" target="_blank" rel="noopener noreferrer">cyiaace.ccu.edu.tw</a></p>
        <p>USR Office: <a href="https://usr.ccu.edu.tw/" target="_blank" rel="noopener noreferrer">usr.ccu.edu.tw</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
